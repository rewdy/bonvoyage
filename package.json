{
  "name": "@rewdy/bon-voyage",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "bin": {
    "bonvoyage": "dist/cli.js",
    "bon-voyage": "dist/cli.js"
  },
  "files": [
    "dist",
    "templates"
  ],
  "scripts": {
    "build": "bun build src/cli.ts --target=node --outdir=dist --sourcemap=inline",
    "clean": "rm -rf dist scss styles",
    "cli": "bun run src/cli.ts",
    "dev": "run-p dev:scss dev:app",
    "dev:app": "rsbuild dev --open",
    "dev:scss": "bun chokidar './templates/*.scss' -c 'bun sass'",
    "sass": "bun run src/copy.ts",
    "format": "biome format . --write",
    "format:check": "biome format . --check",
    "check": "biome check .",
    "check:fix": "biome check . --write",
    "test": "bun test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.12",
    "@bomb.sh/args": "^0.3.1",
    "@clack/prompts": "1.0.0",
    "@rsbuild/core": "^1.7.1",
    "@rsbuild/plugin-react": "^1.4.2",
    "@rsbuild/plugin-sass": "^1.5.0",
    "@types/bun": "latest",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "chalk": "^5.6.2",
    "chokidar-cli": "^3.0.0",
    "handlebars": "^4.7.8",
    "npm-run-all2": "^8.0.4",
    "react": "^19",
    "react-dom": "^19",
    "sass": "^1.97.3",
    "typescript": "^5"
  },
  "dependencies": {}
}
